<Page x:Class="ByteForge.Settings.WinUI.Pages.SavingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="0,0,14,28">
        <StackPanel Spacing="14" MaxWidth="780" Margin="22,16,0,0">

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="保存、预览与性能" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="156" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="新文件编码" Style="{StaticResource FormLabel}" />
                        <ComboBox x:Name="EncodingBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"
                                  Width="200" CornerRadius="8" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="UTF-8" Tag="utf8" />
                            <ComboBoxItem Content="UTF-8 带 BOM" Tag="utf8-bom" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="Markdown 预览" Style="{StaticResource FormLabel}" Margin="0,10,0,0" />
                        <ComboBox x:Name="MarkdownBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                                  Width="200" CornerRadius="8" Margin="0,10,0,0" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="关闭" Tag="off" />
                            <ComboBoxItem Content="底部" Tag="bottom" />
                            <ComboBoxItem Content="右侧" Tag="side" />
                        </ComboBox>

                        <TextBlock Grid.Row="2" Text="高亮上限" Style="{StaticResource FormLabel}" Margin="0,10,0,0" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                            <Slider x:Name="HighlightLimitSlider" Width="220" ValueChanged="HighlightLimitSlider_ValueChanged" />
                            <TextBlock x:Name="HighlightLimitText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                               Text="超过这个体积自动关闭语法高亮（拖动到最左为不限）。关掉高亮能显著降低大文件的内存占用。" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="保存" CornerRadius="9" Padding="20,8"
                        Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <Button Content="恢复默认" CornerRadius="9" Padding="18,8" Click="Reset_Click" />
                <Button Content="打开配置目录" CornerRadius="9" Padding="18,8" Click="Folder_Click" />
            </StackPanel>

            <InfoBar x:Name="HintBar" IsOpen="False" CornerRadius="10" />
        </StackPanel>
    </ScrollViewer>
</Page>
