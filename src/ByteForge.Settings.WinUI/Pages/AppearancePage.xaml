<Page x:Class="ByteForge.Settings.WinUI.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="0,0,14,28">
        <StackPanel Spacing="14" MaxWidth="780" Margin="22,16,0,0">

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="外观" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="156" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="主题" Style="{StaticResource FormLabel}" />
                        <ComboBox x:Name="ThemeBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"
                                  Width="200" CornerRadius="8" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                            <ComboBoxItem Content="跟随系统" Tag="system" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="字体" Style="{StaticResource FormLabel}" Margin="0,10,0,0" />
                        <ComboBox x:Name="FontBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                                  Width="240" CornerRadius="8" Margin="0,10,0,0" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="Consolas" />
                            <ComboBoxItem Content="Cascadia Mono" />
                            <ComboBoxItem Content="Cascadia Code" />
                            <ComboBoxItem Content="Lucida Console" />
                            <ComboBoxItem Content="等线" />
                            <ComboBoxItem Content="微软雅黑" />
                            <ComboBoxItem Content="宋体" />
                            <ComboBoxItem Content="黑体" />
                        </ComboBox>

                        <TextBlock Grid.Row="2" Text="字号" Style="{StaticResource FormLabel}" Margin="0,10,0,0" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                            <Slider x:Name="FontSizeSlider" Width="220" ValueChanged="FontSizeSlider_ValueChanged" />
                            <TextBlock x:Name="FontSizeText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="保存" CornerRadius="9" Padding="20,8"
                        Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <Button Content="恢复默认" CornerRadius="9" Padding="18,8" Click="Reset_Click" />
                <Button Content="打开配置目录" CornerRadius="9" Padding="18,8" Click="Folder_Click" />
            </StackPanel>

            <InfoBar x:Name="HintBar" IsOpen="False" CornerRadius="10" />
        </StackPanel>
    </ScrollViewer>
</Page>
