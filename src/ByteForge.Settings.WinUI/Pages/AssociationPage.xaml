<Page x:Class="ByteForge.Settings.WinUI.Pages.AssociationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="0,0,14,28">
        <StackPanel Spacing="14" MaxWidth="780" Margin="22,16,0,0">

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="文件关联" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="勾选要用 ByteForge 打开的后缀。写入的是当前用户的注册表，不需要管理员权限。" />

                    <Grid x:Name="ExtensionGrid" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="全选" CornerRadius="8" Padding="14,6" Click="SelectAll_Click" />
                        <Button Content="全不选" CornerRadius="8" Padding="14,6" Click="ClearAll_Click" />
                    </StackPanel>

                    <InfoBar x:Name="AssociationBar" Severity="Informational" IsOpen="True" IsClosable="False"
                             CornerRadius="8"
                             Message="Windows 的“默认应用”受系统保护；若之前指定过别的程序，需要在系统“设置 → 默认应用”里再确认一次。" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="保存并应用关联" CornerRadius="9" Padding="20,8"
                        Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <Button Content="恢复默认" CornerRadius="9" Padding="18,8" Click="Reset_Click" />
                <Button Content="打开配置目录" CornerRadius="9" Padding="18,8" Click="Folder_Click" />
            </StackPanel>

            <InfoBar x:Name="HintBar" IsOpen="False" CornerRadius="10" />
        </StackPanel>
    </ScrollViewer>
</Page>
