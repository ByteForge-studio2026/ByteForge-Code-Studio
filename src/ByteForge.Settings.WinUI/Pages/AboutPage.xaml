<Page x:Class="ByteForge.Settings.WinUI.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="0,0,16,32">
        <StackPanel Spacing="16" MaxWidth="720" Margin="24,20,0,0">

            <!-- 头部 -->
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image x:Name="AboutIcon" Width="56" Height="56" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameText" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="MetaText" FontSize="12" Opacity="0.65" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 产品信息 -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="产品信息" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="支持功能" Style="{StaticResource FormLabel}" Opacity="0.65" />
                        <TextBlock x:Name="FeatureText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Text="技术栈" Style="{StaticResource FormLabel}" Opacity="0.65" />
                        <TextBlock x:Name="TechStackText" Grid.Row="1" Grid.Column="1" />

                        <TextBlock Grid.Row="2" Text="开发团队" Style="{StaticResource FormLabel}" Opacity="0.65" />
                        <TextBlock x:Name="TeamText" Grid.Row="2" Grid.Column="1" />

                        <TextBlock Grid.Row="3" Text="官方渠道" Style="{StaticResource FormLabel}" Opacity="0.65" />
                        <TextBlock x:Name="ChannelText" Grid.Row="3" Grid.Column="1" />
                    </Grid>

                    <TextBlock x:Name="LicenseText" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                </StackPanel>
            </Border>

            <!-- 免责声明 -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="免责声明" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" Opacity="0.85" LineHeight="22" />
                </StackPanel>
            </Border>

            <!-- 用户协议 -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="用户协议" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border CornerRadius="10" Padding="14" Height="220"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <ScrollViewer>
                            <TextBlock x:Name="AgreementTextBlock" TextWrapping="Wrap" FontSize="13" LineHeight="22" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
