<Page x:Class="ByteForge.Settings.WinUI.Pages.EditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="0,0,14,28">
        <StackPanel Spacing="14" MaxWidth="780" Margin="22,16,0,0">

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="编辑行为" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                    <ToggleSwitch x:Name="LineNumbersSwitch" Header="显示行号" />
                    <ToggleSwitch x:Name="WordWrapSwitch" Header="自动换行（开启后隐藏行号栏）" />
                    <ToggleSwitch x:Name="CurrentLineSwitch" Header="高亮光标所在行" />
                    <ToggleSwitch x:Name="AutoIndentSwitch" Header="回车时沿用上一行缩进" />
                    <ToggleSwitch x:Name="AutoBracketsSwitch" Header="自动补全括号与引号" />
                    <ToggleSwitch x:Name="StatusBarSwitch" Header="显示状态栏" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="保存" CornerRadius="9" Padding="20,8"
                        Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <Button Content="恢复默认" CornerRadius="9" Padding="18,8" Click="Reset_Click" />
                <Button Content="打开配置目录" CornerRadius="9" Padding="18,8" Click="Folder_Click" />
            </StackPanel>

            <InfoBar x:Name="HintBar" IsOpen="False" CornerRadius="10" />
        </StackPanel>
    </ScrollViewer>
</Page>
