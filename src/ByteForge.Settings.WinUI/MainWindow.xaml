<Window x:Class="ByteForge.Settings.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ByteForge Code Studio">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：ExtendsContentIntoTitleBar + SetTitleBar 在代码里设置 -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="40"
              Padding="12,0,0,0"
              VerticalAlignment="Top"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image x:Name="TitleBarIcon"
                   Grid.Column="0"
                   Width="18"
                   Height="18"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center" />

            <TextBlock x:Name="TitleBarText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       Opacity="0.85"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="200"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <!-- "设置"是可展开的分组，下面分小项；WinUI 3 不支持 Icon="Setting" 这种字符串写法 -->
                <NavigationViewItem x:Name="SettingsGroup" Content="设置" Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Name="AppearanceItem" Content="外观" Tag="appearance" />
                        <NavigationViewItem Content="编辑行为" Tag="editor" />
                        <NavigationViewItem Content="缩进与换行" Tag="indent" />
                        <NavigationViewItem Content="保存与预览" Tag="saving" />
                        <NavigationViewItem Content="启动与窗口" Tag="startup" />
                        <NavigationViewItem Content="文件关联" Tag="association" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
