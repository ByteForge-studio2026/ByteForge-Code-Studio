<Window x:Class="ByteForge.Setup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="ByteForge Code Studio 安装程序"
    Width="720" Height="560"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Background="#FFFFFF"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <!-- 自定义顶栏：去掉系统标题栏（和主程序一致的观感） -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="#F6F6F7"
                BorderBrush="#E4E4E7" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="TitleBarIcon" Width="18" Height="18" Margin="12,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="ByteForge Code Studio 安装程序" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" ToolTip="最小化"
                            AutomationProperties.Name="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinButton_Click">
                        <Path Width="12" Height="12" Stretch="Uniform" Stroke="#3A3A3A" StrokeThickness="2"
                              Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M5 12 H19" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" ToolTip="关闭"
                            AutomationProperties.Name="关闭"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click">
                        <Path Width="12" Height="12" Stretch="Uniform" Stroke="#3A3A3A" StrokeThickness="2"
                              Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M18 6 L6 18 M6 6 L18 18" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容 -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Image x:Name="HeaderIcon" Width="40" Height="40" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel>
                    <TextBlock Text="ByteForge Code Studio" FontSize="20" FontWeight="Bold" />
                    <TextBlock x:Name="SubtitleText" Text="轻量级文本 / 源码编辑器" Foreground="#666666" />
                </StackPanel>
            </StackPanel>

            <!-- 第一步：用户协议 -->
            <StackPanel x:Name="StepAgreement" Grid.Row="1">
                <TextBlock Text="请仔细阅读以下用户协议，滚动到底部后方可勾选同意。" Margin="0,0,0,8" />
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="10" Height="280">
                    <ScrollViewer x:Name="AgreementScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="AgreementScroller_ScrollChanged">
                        <TextBlock x:Name="AgreementTextBlock" TextWrapping="Wrap" Margin="14" FontSize="13" />
                    </ScrollViewer>
                </Border>

                <TextBlock x:Name="ScrollHint" Text="（请将协议滚动至底部）" Foreground="#C62828"
                           FontSize="12" Margin="0,8,0,0" />

                <CheckBox x:Name="AgreeCheckBox"
                          Content="我已阅读并同意《ByteForge 产品用户协议 - 2026 年修订版》"
                          IsEnabled="False" Margin="0,10,0,0"
                          Checked="AgreeCheckBox_Changed" Unchecked="AgreeCheckBox_Changed" />
            </StackPanel>

            <!-- 第二步：安装位置与选项 -->
            <StackPanel x:Name="StepOptions" Grid.Row="1" Visibility="Collapsed">
                <TextBlock Text="安装到哪个磁盘？" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                <WrapPanel x:Name="DrivePanel" />

                <TextBlock Text="安装位置" FontSize="12" Opacity="0.6" Margin="0,16,0,5" />
                <DockPanel>
                    <Button Content="更改…" DockPanel.Dock="Right" Width="76" Margin="8,0,0,0"
                            Style="{StaticResource NormalButton}" Click="BrowseButton_Click" />
                    <Border CornerRadius="9" BorderBrush="#CCCCCC" BorderThickness="1" Background="#F7F7F9">
                        <TextBlock x:Name="TargetPathText" Height="30" Margin="10,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>
                </DockPanel>

                <CheckBox x:Name="ShortcutCheckBox" Content="创建开始菜单快捷方式" IsChecked="True" Margin="0,16,0,8" />
                <CheckBox x:Name="DefaultEditorCheckBox" Content="设为默认编辑器（.py / .c / .java / .cs / .md 等）" IsChecked="True" />

                <TextBlock Text="安装就是把内置的压缩包解压到上面的位置：不写系统目录，也不需要管理员权限。"
                           Foreground="#666666" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 第三步：安装进度 / 完成 -->
            <StackPanel x:Name="StepProgress" Grid.Row="1" Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" Text="准备安装…" Margin="0,0,0,8" />
                <ProgressBar x:Name="ProgressBar" Height="20" Minimum="0" Maximum="100" />
                <TextBlock x:Name="FinishText" TextWrapping="Wrap" Margin="0,16,0,0" />
            </StackPanel>

            <!-- 底部按钮 -->
            <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="取消" DockPanel.Dock="Right"
                        Style="{StaticResource NormalButton}" Click="CancelButton_Click" />
                <Button x:Name="NextButton" Content="下一步" DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="NextButton_Click" />
                <Button x:Name="BackButton" Content="上一步" DockPanel.Dock="Left"
                        Style="{StaticResource NormalButton}" Visibility="Collapsed" Click="BackButton_Click" />
            </DockPanel>
        </Grid>

        <!-- 应用内目录选择器：不用系统的 FolderBrowserDialog，在窗口里自己列目录挑安装位置 -->
        <Grid x:Name="FolderPickerOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
              Background="#33000000" Panel.ZIndex="10"
              MouseLeftButtonDown="FolderPickerOverlay_MouseLeftButtonDown">
            <Border x:Name="FolderPickerCard" Width="620" Height="450" Background="White" CornerRadius="12"
                    BorderBrush="#CCCCCC" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel LastChildFill="True" Margin="18">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="选择安装位置" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button x:Name="FolderPickerClose" Grid.Column="1" Content="✕" Width="30" Height="28"
                                Padding="0" MinWidth="0" Style="{StaticResource NormalButton}"
                                Click="FolderPickerClose_Click" />
                    </Grid>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FolderUpButton" Grid.Column="0" Content="上一级" Width="76" Height="30"
                                Padding="0" MinWidth="0" Margin="0,0,8,0"
                                Style="{StaticResource NormalButton}" Click="FolderUpButton_Click" />
                        <TextBox x:Name="FolderPathBox" Grid.Column="1" Height="30"
                                 VerticalContentAlignment="Center" BorderBrush="#CCCCCC"
                                 BorderThickness="1" KeyDown="FolderPathBox_KeyDown" />
                        <Button x:Name="FolderNewButton" Grid.Column="2" Content="新建文件夹" Width="110" Height="30"
                                Padding="0" MinWidth="0" Margin="8,0,0,0"
                                Style="{StaticResource NormalButton}" Click="FolderNewButton_Click" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="12" Foreground="#666666"
                               TextWrapping="Wrap"
                               Text="上面是安装位置。双击下面列表里的文件夹可进入，点「选择此文件夹」确认。" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                        <Button x:Name="FolderPickerCancel" Content="取消" Height="30" Padding="14,5"
                                MinWidth="0" Style="{StaticResource NormalButton}" Margin="0,0,8,0"
                                Click="FolderPickerCancel_Click" />
                        <Button x:Name="FolderPickerOk" Content="选择此文件夹" Height="30" Padding="16,5"
                                MinWidth="0" Style="{StaticResource PrimaryButton}" Click="FolderPickerOk_Click" />
                    </StackPanel>

                    <Border CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1">
                        <ListBox x:Name="FolderListBox" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Margin="4" MouseDoubleClick="FolderListBox_MouseDoubleClick" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
