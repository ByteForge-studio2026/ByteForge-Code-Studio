<Window x:Class="ByteForge.Editor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ByteForge.Editor.Wpf.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ByteForge Code Studio"
        Width="1100" Height="720" MinWidth="620" MinHeight="400"
        AllowDrop="True"
        Background="#F2F2F4"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <!-- 去掉 Windows 自带的标题栏与系统按钮，改由下方 TopBar 自己画 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自定义顶栏（替代系统标题栏） -->
        <Border x:Name="TopBar" Grid.Row="0" Height="38" Background="#F6F6F7" Padding="12,0"
                Margin="8,8,8,0" CornerRadius="10" BorderBrush="#E4E4E7" BorderThickness="1"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="LogoIcon" Width="16" Height="16" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="AppTitle" Text="ByteForge Code Studio" FontSize="12.5"
                               Margin="9,0,0,0" VerticalAlignment="Center" />

                    <!-- 历史记录（类似 IDEA 的最近文件）：点开下拉列出最近打开 -->
                    <Rectangle Width="1" Height="16" Fill="#D8D8DC" Margin="14,0,6,0" VerticalAlignment="Center" />
                    <Button x:Name="HistoryButton" Style="{StaticResource CaptionButton}" Width="28" Height="28"
                            ToolTip="历史记录" AutomationProperties.Name="历史记录"
                            Click="HistoryButton_Click" Cursor="Hand">
                        <Path x:Name="HistoryGlyph" Width="14" Height="14" Stretch="Uniform"
                              Stroke="#3A3A3A" StrokeThickness="2" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M12 8 L12 12 L15 13 M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z" />
                    </Button>
                </StackPanel>

                <!-- 顶部字符搜索框：常驻顶栏；没打开文件时仍可输入，但会提示先打开文件 -->
                <Border x:Name="TopSearchCard" Grid.Column="1" Width="272" Height="26"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" CornerRadius="9" Background="#FFFFFF"
                        BorderBrush="#D8D8DC" BorderThickness="1"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="TopSearchIcon" Grid.Column="0" Width="13" Height="13" Stretch="Uniform"
                              Margin="9,0,6,0" Stroke="#8A8A8A" StrokeThickness="2" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M19 11a8 8 0 1 0-16 0 8 8 0 0 0 16 0z M21 21 L16.65 16.65" />
                        <Grid Grid.Column="1" Margin="0,0,9,0">
                            <TextBox x:Name="TopSearchBox" Background="Transparent" BorderThickness="0"
                                     FontSize="12.5" Padding="0" VerticalContentAlignment="Center"
                                     TextChanged="TopSearchBox_TextChanged" KeyDown="TopSearchBox_KeyDown"
                                     GotKeyboardFocus="TopSearchBox_GotFocus" />
                            <TextBlock x:Name="TopSearchPlaceholder" Text="搜索字符 (Ctrl+F)" FontSize="12"
                                       Opacity="0.45" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle x:Name="TitleSeparator" Width="1" Height="18" Fill="#D8D8DC" Margin="9,0,4,0" />

                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" ToolTip="最小化"
                            Click="MinButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="MinGlyph" Width="13" Height="13" Stretch="Uniform"
                              Stroke="#3A3A3A" StrokeThickness="2" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M5 12 H19" />
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" ToolTip="最大化"
                            Click="MaxButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="MaxGlyph" Width="13" Height="13" Stretch="Uniform"
                              Stroke="#3A3A3A" StrokeThickness="2" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" ToolTip="关闭"
                            Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="CloseGlyph" Width="13" Height="13" Stretch="Uniform"
                              Stroke="#3A3A3A" StrokeThickness="2" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M18 6 L6 18 M6 6 L18 18" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 历史记录下拉：挂在顶栏历史按钮下方 -->
        <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=HistoryButton}"
               Placement="Bottom" AllowsTransparency="True" Focusable="False"
               StaysOpen="False" PopupAnimation="Fade" VerticalOffset="6">
            <Border x:Name="HistoryCard" MinWidth="340" MaxWidth="520" MaxHeight="380"
                    CornerRadius="12" Background="#FFFFFF" BorderBrush="#E4E4E7"
                    BorderThickness="1" Padding="6" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.16" Direction="270" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="8,4,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HistoryTitle" Text="历史记录" FontSize="12"
                                   FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                        <Button x:Name="HistoryClear" Grid.Column="1" Content="清空" FontSize="11"
                                Style="{StaticResource RoundedButton}" Padding="10,3"
                                Background="Transparent" BorderBrush="#D8D8DC" Foreground="#8A8A8A"
                                Click="HistoryClear_Click" ToolTip="清空历史记录" />
                    </Grid>
                    <ListBox x:Name="HistoryList" Grid.Row="1" Style="{StaticResource FindResultsList}"
                             ItemContainerStyle="{StaticResource FindResultItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="320"
                             BorderThickness="0" Background="Transparent" />
                </Grid>
            </Border>
        </Popup>

        <!-- 主体：活动栏 + 侧栏（最近打开）+ 编辑区，整块是一张圆角卡片 -->
        <Border x:Name="MainCard" Grid.Row="1" Margin="8,8,8,8" CornerRadius="12"
                Background="#FFFFFF" BorderBrush="#E4E4E7" BorderThickness="1" ClipToBounds="True">
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ActivityColumn" Width="44" />
                    <ColumnDefinition x:Name="SideColumn" Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 活动栏 -->
                <Border x:Name="ActivityBar" Grid.Column="0" Background="#EFEFF1">
                    <Grid>
                    <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                        <Button x:Name="ActFileButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                                Background="Transparent" ToolTip="打开文件（内置文件管理器，Ctrl+O）"
                                Click="FileButton_Click">
                            <Path x:Name="ActFileGlyph" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="#5A5A62" StrokeThickness="2" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                        </Button>
                        <Button x:Name="ActSideButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                                    Background="Transparent" ToolTip="显示 / 隐藏侧栏（最近打开）"
                                    Click="ToggleSidePanel_Click">
                                <Path x:Name="ActSideGlyph" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="#5A5A62" StrokeThickness="2" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M3 6 H21 M3 12 H21 M3 18 H21" />
                            </Button>
                            <Button x:Name="ActSaveButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                                    Background="Transparent" ToolTip="保存 (Ctrl+S)" Click="SaveButton_Click">
                                <Path x:Name="ActSaveGlyph" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="#5A5A62" StrokeThickness="2" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z M17 21 L17 13 L7 13 L7 21 M7 3 L7 8 L15 8" />
                            </Button>
                            <Button x:Name="ActPreviewButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                                    Background="Transparent" ToolTip="Markdown 预览" Click="PreviewButton_Click">
                                <Path x:Name="ActPreviewGlyph" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="#5A5A62" StrokeThickness="2" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M15 12a3 3 0 1 0-6 0 3 3 0 0 0 6 0z" />
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <Button x:Name="ActSettingsButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                                    Background="Transparent" ToolTip="设置 / 关于（主程序）" Click="SettingsButton_Click">
                                <Path x:Name="ActSettingsGlyph" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="#5A5A62" StrokeThickness="2" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z M15 12a3 3 0 1 0-6 0 3 3 0 0 0 6 0z" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 侧栏：最近打开 -->
                <Border x:Name="SidePanel" Grid.Column="1" Background="#F9F9FA"
                        BorderBrush="#E9E9EC" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="13,10,8,5">
                            <TextBlock x:Name="SideHeader" Text="最近打开" FontSize="11" Opacity="0.55"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="NewGroupButton" Content="新建组" FontSize="11"
                                        Padding="8,2" Margin="0,0,6,0"
                                        Style="{StaticResource RoundedButton}" Background="Transparent"
                                        BorderBrush="#D8D8DC" Foreground="#8A8A8A"
                                        ToolTip="新建一个自建分组（文件可右键移入）"
                                        Click="NewGroup_Click" />
                                <Button x:Name="ClearRecentButton" Content="清空" FontSize="11"
                                        Padding="8,2"
                                        Style="{StaticResource RoundedButton}" Background="Transparent"
                                        BorderBrush="#D8D8DC" Foreground="#8A8A8A"
                                        Click="ClearRecent_Click" />
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="RecentList" Style="{StaticResource RecentListBox}"
                                 ItemContainerStyle="{StaticResource RecentItem}" />
                    </DockPanel>
                </Border>

                <!-- 编辑区：标签栏 + 面包屑 + 内容 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标签栏 -->
                    <Border x:Name="TabBar" Grid.Row="0" Background="#F2F2F4" Height="33"
                            BorderBrush="#E4E4E7" BorderThickness="0,0,0,1" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Border x:Name="FileTab" CornerRadius="8,8,0,0" Background="#FFFFFF"
                                    Padding="15,6,10,6" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TabFileText" FontSize="12" MaxWidth="240"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TabDirtyMark" Text="●" FontSize="10" Foreground="#C9822B"
                                               Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <Button x:Name="CloseTabButton" Content="✕" FontSize="10" Padding="0"
                                            Width="20" Height="18" Margin="8,0,0,0" Background="Transparent"
                                            Foreground="#9A9AA2" BorderThickness="0" Cursor="Hand"
                                            ToolTip="关闭文件" Click="CloseTabButton_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 面包屑 -->
                    <Border x:Name="BreadcrumbBar" Grid.Row="1" Background="#FFFFFF" Padding="15,5"
                            Visibility="Collapsed">
                        <TextBlock x:Name="BreadcrumbText" FontSize="11" Opacity="0.5"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- 内容：欢迎页 / 编辑区 -->
                    <Grid Grid.Row="2">
                        <Border x:Name="WelcomePanel" Visibility="Visible">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="28">
                                    <Image x:Name="WelcomeIcon" Width="84" Height="84" HorizontalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="ByteForge Code Studio" FontSize="23" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,20,0,6" />
                                    <TextBlock x:Name="WelcomeSubtitle"
                                               Text="把文件拖进窗口即可开始编辑"
                                               HorizontalAlignment="Center" Opacity="0.6" FontSize="13"
                                               TextWrapping="Wrap" TextAlignment="Center" />
                                    <Border Style="{StaticResource PillBorder}" Background="#00000008"
                                            Padding="14,9" Margin="0,22,0,0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="WelcomeHint" FontSize="12" Opacity="0.65"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Text="也可以双击任意文件——把它关联到 ByteForge 后就会直接打开" />
                                    </Border>
                                    <Button x:Name="WelcomeOpenButton" Content="打开文件" FontSize="13.5"
                                            Padding="24,8" Margin="0,18,0,0" Style="{StaticResource RoundedButton}"
                                            Background="#2F6FEB" BorderBrush="#2F6FEB" Foreground="#FFFFFF"
                                            HorizontalAlignment="Center" Click="FileButton_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Grid x:Name="ContentGrid" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="EditorRow" Height="*" />
                                <RowDefinition x:Name="SplitterRow" Height="Auto" />
                                <RowDefinition x:Name="PreviewRow" Height="0" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="EditorColumn" Width="*" />
                                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                                <ColumnDefinition x:Name="PreviewColumn" Width="0" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Margin="12" CornerRadius="12"
                                    Background="#FFFFFF" ClipToBounds="True">
                                <controls:CodeEditor x:Name="Editor" />
                            </Border>

                            <GridSplitter x:Name="Splitter" Grid.Row="1" Grid.Column="0"
                                          Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          Background="#3F3F46" ShowsPreview="True" Visibility="Collapsed" />

                            <Border x:Name="PreviewCard" Grid.Row="2" Grid.Column="0" Margin="0,0,12,12"
                                    CornerRadius="12" Background="#F9F9FA" ClipToBounds="True">
                                <RichTextBox x:Name="PreviewBox" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent" Padding="16"
                                             VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </Grid>

                        <!-- 应用内查找面板（Ctrl+F 唤出，不另开窗口；底部浮层，列出结果可点击定位） -->
                        <Border x:Name="FindPanel" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                Margin="12,0,12,12" MaxHeight="320" CornerRadius="10" Visibility="Collapsed"
                                Background="#FFFFFF" BorderBrush="#E4E4E7" BorderThickness="1" Padding="10"
                                Panel.ZIndex="50">
                            <DockPanel LastChildFill="True" VerticalAlignment="Stretch">
                                <!-- 搜索框在顶栏；这里只放结果计数与跳转 / 关闭 -->
                                <DockPanel DockPanel.Dock="Top" LastChildFill="False" VerticalAlignment="Center"
                                           Margin="0,0,0,8">
                                    <TextBlock x:Name="FindCount" Text="" FontSize="11.5" Opacity="0.6"
                                               VerticalAlignment="Center" Margin="2,0,4,0" MinWidth="56" />
                                    <Button x:Name="FindPrevButton" Style="{StaticResource IconButton}" Width="28" Height="28"
                                            ToolTip="上一个 (Shift+Enter)" AutomationProperties.Name="上一个" Margin="2,0,0,0" Click="FindPrev_Click">
                                        <Path x:Name="FindPrevGlyph" Width="16" Height="16" Stretch="Uniform"
                                              Stroke="#6E6E73" StrokeThickness="2" Fill="Transparent"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M6 15 L12 9 L18 15" />
                                    </Button>
                                    <Button x:Name="FindNextButton" Style="{StaticResource IconButton}" Width="28" Height="28"
                                            ToolTip="下一个 (Enter)" AutomationProperties.Name="下一个" Margin="2,0,0,0" Click="FindNext_Click">
                                        <Path x:Name="FindNextGlyph" Width="16" Height="16" Stretch="Uniform"
                                              Stroke="#6E6E73" StrokeThickness="2" Fill="Transparent"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M6 9 L12 15 L18 9" />
                                    </Button>
                                    <Button x:Name="FindMatchCase" Style="{StaticResource IconButton}" Width="30" Height="28"
                                            ToolTip="区分大小写 (Alt+C)" Margin="6,0,0,0" Click="FindMatchCase_Click">
                                        <TextBlock x:Name="FindMatchCaseText" Text="Aa" FontSize="12.5"
                                                   FontWeight="SemiBold" Foreground="#6E6E73" />
                                    </Button>
                                    <Button x:Name="FindCloseButton" Style="{StaticResource IconButton}" Width="28" Height="28"
                                            ToolTip="关闭 (Esc)" Margin="2,0,0,0" Click="FindClose_Click">
                                        <Path x:Name="FindCloseGlyph" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="#6E6E73" StrokeThickness="2" Fill="Transparent"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M18 6 L6 18 M6 6 L18 18" />
                                    </Button>
                                </DockPanel>
                                <ListBox x:Name="FindResults" Style="{StaticResource FindResultsList}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </DockPanel>
                        </Border>

                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Border x:Name="StatusBar" Grid.Row="2" Background="#4C8BF5" Padding="12,4"
                Margin="8,0,8,8" CornerRadius="10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource PillBorder}" Background="#00000020" Padding="9,2" Margin="0,0,7,0">
                        <TextBlock x:Name="StatusFile" Text="未打开文件" FontSize="11.5" />
                    </Border>
                    <Border Style="{StaticResource PillBorder}" Background="#00000014" Padding="9,2" Margin="0,0,7,0">
                        <TextBlock x:Name="StatusCaret" Text="行 1，列 1" FontSize="11.5" />
                    </Border>
                    <Border Style="{StaticResource PillBorder}" Background="#00000014" Padding="9,2" Margin="0,0,7,0">
                        <TextBlock x:Name="StatusLanguage" Text="纯文本" FontSize="11.5" />
                    </Border>
                    <Border Style="{StaticResource PillBorder}" Background="#00000014" Padding="9,2" Margin="0,0,7,0">
                        <TextBlock x:Name="StatusEncoding" Text="UTF-8" FontSize="11.5" />
                    </Border>
                    <Border x:Name="HintPill" Style="{StaticResource PillBorder}" Background="#C0392B"
                            Padding="9,2" Visibility="Collapsed">
                        <TextBlock x:Name="StatusHint" Text="" FontSize="11.5" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Border Style="{StaticResource PillBorder}" Background="#00000014" Padding="9,2" Margin="0,0,7,0">
                        <TextBlock x:Name="StatusSize" Text="0 B" FontSize="11.5" />
                    </Border>
                    <Border Style="{StaticResource PillBorder}" Background="#00000014" Padding="9,2">
                        <TextBlock Text="ByteForge" FontSize="11.5" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 应用内弹窗：提示 / 确认（不另开窗口） -->
        <Grid x:Name="DialogOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#33000000" Panel.ZIndex="100">
            <Border x:Name="DialogCard" MaxWidth="460" MinWidth="320"
                    Background="#FFFFFF" CornerRadius="12" Padding="22,20"
                    BorderBrush="#E4E4E7" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock x:Name="DialogMessage" FontSize="13" TextWrapping="Wrap"
                               Opacity="0.8" LineHeight="20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="DialogNo" Content="否" Style="{StaticResource RoundedButton}"
                                Padding="16,6" Margin="0,0,8,0" Visibility="Collapsed"
                                Click="DialogNo_Click" />
                        <Button x:Name="DialogYes" Content="确定" Style="{StaticResource RoundedButton}"
                                Padding="16,6" Click="DialogYes_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 应用内"另存为"面板（不另开窗口 / 不用系统文件框） -->
        <Grid x:Name="SaveAsOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#33000000" Panel.ZIndex="100">
            <Border x:Name="SaveAsCard" MaxWidth="520" MinWidth="360"
                    Background="#FFFFFF" CornerRadius="12" Padding="22"
                    BorderBrush="#E4E4E7" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="另存为" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="保存位置（完整路径）" FontSize="12" Opacity="0.6" Margin="0,0,0,5" />
                    <TextBox x:Name="SaveAsPath" FontSize="13" Padding="9,7"
                             BorderBrush="#D0D0D4" BorderThickness="1" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="SaveAsCancel" Content="取消" Style="{StaticResource RoundedButton}"
                                Padding="16,6" Margin="0,0,8,0" Click="SaveAsCancel_Click" />
                        <Button x:Name="SaveAsOk" Content="保存" Style="{StaticResource RoundedButton}"
                                Padding="16,6" Click="SaveAsOk_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 应用内文本输入（新建分组 / 重命名分组，不另开窗口） -->
        <Grid x:Name="InputOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#33000000" Panel.ZIndex="110">
            <Border x:Name="InputCard" MaxWidth="420" MinWidth="330"
                    Background="#FFFFFF" CornerRadius="12" Padding="22"
                    BorderBrush="#E4E4E7" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="InputTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock x:Name="InputLabel" Text="分组名称" FontSize="12" Opacity="0.6" Margin="0,0,0,5" />
                    <TextBox x:Name="InputBox" FontSize="13" Padding="9,7"
                             BorderBrush="#D0D0D4" BorderThickness="1"
                             KeyDown="InputBox_KeyDown" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="InputCancel" Content="取消" Style="{StaticResource RoundedButton}"
                                Padding="16,6" Margin="0,0,8,0" Click="InputCancel_Click" />
                        <Button x:Name="InputOk" Content="确定" Style="{StaticResource RoundedButton}"
                                Padding="16,6" Click="InputOk_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 应用内文件管理器：不用系统文件对话框，自己在窗口里挑文件 -->
        <Grid x:Name="FileBrowserOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#33000000" Panel.ZIndex="110"
              MouseLeftButtonDown="FileBrowserOverlay_MouseLeftButtonDown">
            <controls:FileBrowserPanel x:Name="FileBrowser"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- 应用内"添加到分组"：从最近打开里多选（不弹系统文件框） -->
        <Grid x:Name="AddToGroupOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#33000000" Panel.ZIndex="120"
              MouseLeftButtonDown="AddToGroupOverlay_MouseLeftButtonDown">
            <Border x:Name="AddToGroupCard" MaxWidth="540" MinWidth="380" MaxHeight="560"
                    Background="#FFFFFF" CornerRadius="12" Padding="20"
                    BorderBrush="#E4E4E7" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AddToGroupTitle" Grid.Column="0" Text="添加到分组"
                                   FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="AddToGroupClose" Grid.Column="1" Content="✕" FontSize="12"
                                Width="30" Height="28" Padding="0" Style="{StaticResource RoundedButton}"
                                Background="Transparent" BorderBrush="#D8D8DC" Foreground="#8A8A8A"
                                Click="AddToGroupClose_Click" />
                    </Grid>

                    <TextBlock x:Name="AddToGroupHint" DockPanel.Dock="Top" FontSize="12" Opacity="0.6"
                               Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button x:Name="AddToGroupSelectAll" Content="全选" FontSize="12.5"
                                Padding="14,6" Margin="0,0,8,0" Style="{StaticResource RoundedButton}"
                                Background="Transparent" BorderBrush="#D8D8DC" Foreground="#8A8A8A"
                                Click="AddToGroupSelectAll_Click" />
                        <Button x:Name="AddToGroupCancel" Content="取消" FontSize="12.5"
                                Padding="14,6" Margin="0,0,8,0" Style="{StaticResource RoundedButton}"
                                Background="Transparent" BorderBrush="#D8D8DC" Foreground="#8A8A8A"
                                Click="AddToGroupCancel_Click" />
                        <Button x:Name="AddToGroupConfirm" Content="添加到分组" FontSize="12.5"
                                Padding="16,6" Style="{StaticResource RoundedButton}"
                                Background="#2F6FEB" BorderBrush="#2F6FEB" Foreground="#FFFFFF"
                                Click="AddToGroupConfirm_Click" />
                    </StackPanel>

                    <Border CornerRadius="10" Background="#F7F7F9" BorderBrush="#E4E4E7" BorderThickness="1">
                        <ListBox x:Name="AddToGroupList" Style="{StaticResource RecentListBox}"
                                 ItemContainerStyle="{StaticResource RecentItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="4" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 应用内设置面板（设置程序已合并进编辑器，不再另起一个 exe） -->
        <Grid x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#33000000" Panel.ZIndex="100">
            <Border x:Name="SettingsCard" MaxWidth="780" MaxHeight="560" MinWidth="620"
                    Background="#FFFFFF" CornerRadius="12"
                    BorderBrush="#E4E4E7" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:SettingsPanel x:Name="SettingsView" />
            </Border>
        </Grid>
    </Grid>
</Window>
