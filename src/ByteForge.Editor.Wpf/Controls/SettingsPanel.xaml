<UserControl x:Class="ByteForge.Editor.Wpf.Controls.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid Grid.Row="0" Margin="20,16,16,10">
            <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="30" Height="30"
                    HorizontalAlignment="Right" ToolTip="关闭" Click="Close_Click">
                <Path Width="14" Height="14" Stretch="Uniform"
                      Stroke="#6E6E73" StrokeThickness="2" Fill="Transparent"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M18 6 L6 18 M6 6 L18 18" />
            </Button>
        </Grid>

        <!-- 主体：左侧分类 + 右侧内容 -->
        <Grid Grid.Row="1" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="152" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="NavList" Grid.Column="0" Style="{StaticResource FindResultsList}"
                     SelectionChanged="NavList_SelectionChanged" Margin="0,0,12,0">
                <ListBoxItem Content="外观" Tag="appearance" Style="{StaticResource FindResultItem}" />
                <ListBoxItem Content="编辑" Tag="editor" Style="{StaticResource FindResultItem}" />
                <ListBoxItem Content="缩进与换行" Tag="indent" Style="{StaticResource FindResultItem}" />
                <ListBoxItem Content="保存与预览" Tag="save" Style="{StaticResource FindResultItem}" />
                <ListBoxItem Content="启动与窗口" Tag="startup" Style="{StaticResource FindResultItem}" />
                <ListBoxItem Content="文件关联" Tag="assoc" Style="{StaticResource FindResultItem}" />
                <ListBoxItem Content="关于" Tag="about" Style="{StaticResource FindResultItem}" />
            </ListBox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="4,0,8,0">
                <StackPanel>

                    <!-- 外观 -->
                    <StackPanel x:Name="AppearancePanel">
                        <TextBlock Text="主题" Opacity="0.65" Margin="0,4,0,5" />
                        <ComboBox x:Name="CmbTheme" Width="220" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                            <ComboBoxItem Content="跟随系统" Tag="system" />
                        </ComboBox>

                        <TextBlock Text="字体" Opacity="0.65" Margin="0,0,0,5" />
                        <ComboBox x:Name="CmbFont" Width="220" HorizontalAlignment="Left"
                                  IsEditable="True" Margin="0,0,0,14">
                            <ComboBoxItem Content="Consolas" />
                            <ComboBoxItem Content="Cascadia Mono" />
                            <ComboBoxItem Content="Cascadia Code" />
                            <ComboBoxItem Content="Courier New" />
                            <ComboBoxItem Content="Lucida Console" />
                        </ComboBox>

                        <TextBlock Text="字号" Opacity="0.65" Margin="0,0,0,5" />
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SliderFont" Width="200" Minimum="9" Maximum="28"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="SliderFont_ValueChanged" />
                            <TextBlock x:Name="TxtFontSize" Text="14" Width="30" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 编辑 -->
                    <StackPanel x:Name="EditorPanel" Visibility="Collapsed">
                        <CheckBox x:Name="ChkLineNumbers" Content="显示行号" Margin="0,6" />
                        <CheckBox x:Name="ChkWordWrap" Content="自动换行" Margin="0,6" />
                        <CheckBox x:Name="ChkCurrentLine" Content="高亮光标所在行" Margin="0,6" />
                        <CheckBox x:Name="ChkAutoIndent" Content="回车时沿用上一行缩进" Margin="0,6" />
                        <CheckBox x:Name="ChkAutoClose" Content="自动补全括号 / 引号" Margin="0,6" />
                        <CheckBox x:Name="ChkStatusBar" Content="显示状态栏" Margin="0,6" />
                    </StackPanel>

                    <!-- 缩进与换行 -->
                    <StackPanel x:Name="IndentPanel" Visibility="Collapsed">
                        <TextBlock Text="Tab 宽度" Opacity="0.65" Margin="0,4,0,5" />
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SliderTab" Width="200" Minimum="1" Maximum="8"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="SliderTab_ValueChanged" />
                            <TextBlock x:Name="TxtTabSize" Text="4" Width="30" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox x:Name="ChkTabToSpaces" Content="用空格代替 Tab" Margin="0,14,0,0" />

                        <TextBlock Text="保存时使用的换行符" Opacity="0.65" Margin="0,16,0,5" />
                        <ComboBox x:Name="CmbLineEnding" Width="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="CRLF（Windows）" Tag="crlf" />
                            <ComboBoxItem Content="LF（Unix / macOS）" Tag="lf" />
                            <ComboBoxItem Content="保持文件原样" Tag="keep" />
                        </ComboBox>

                        <CheckBox x:Name="ChkTrimTrailing" Content="保存时去除行尾空格" Margin="0,16,0,0" />
                        <CheckBox x:Name="ChkFinalNewline" Content="保存时在文件末尾补一个换行" Margin="0,6" />
                    </StackPanel>

                    <!-- 保存与预览 -->
                    <StackPanel x:Name="SavePanel" Visibility="Collapsed">
                        <TextBlock Text="新文件默认编码" Opacity="0.65" Margin="0,4,0,5" />
                        <ComboBox x:Name="CmbEncoding" Width="220" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <ComboBoxItem Content="UTF-8" Tag="utf8" />
                            <ComboBoxItem Content="UTF-8 带 BOM" Tag="utf8-bom" />
                        </ComboBox>

                        <TextBlock Text="Markdown 预览位置" Opacity="0.65" Margin="0,0,0,5" />
                        <ComboBox x:Name="CmbPreview" Width="220" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <ComboBoxItem Content="关闭" Tag="off" />
                            <ComboBoxItem Content="底部" Tag="bottom" />
                            <ComboBoxItem Content="侧边" Tag="side" />
                        </ComboBox>

                        <TextBlock Text="语法高亮体积上限（KB，0 = 不限）" Opacity="0.65" Margin="0,0,0,5" />
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SliderHighlight" Width="200" Minimum="0" Maximum="4096"
                                    TickFrequency="64" IsSnapToTickEnabled="True"
                                    ValueChanged="SliderHighlight_ValueChanged" />
                            <TextBlock x:Name="TxtHighlight" Text="512" Width="44" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 启动与窗口 -->
                    <StackPanel x:Name="StartupPanel" Visibility="Collapsed">
                        <CheckBox x:Name="ChkOpenLast" Content="启动时打开上次的文件" Margin="0,6" />
                        <CheckBox x:Name="ChkRememberSize" Content="记住窗口大小与位置" Margin="0,6" />

                        <TextBlock Text="最近文件保留条数" Opacity="0.65" Margin="0,16,0,5" />
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SliderRecent" Width="200" Minimum="0" Maximum="50"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="SliderRecent_ValueChanged" />
                            <TextBlock x:Name="TxtRecent" Text="10" Width="30" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 文件关联 -->
                    <StackPanel x:Name="AssocPanel" Visibility="Collapsed">
                        <CheckBox x:Name="ChkDefaultEditor" Content="设为默认编辑器（双击文件用它打开）" Margin="0,6" />
                        <TextBlock Text="要关联的后缀，用逗号或空格分隔（不含点）" Opacity="0.65"
                                   Margin="0,14,0,5" TextWrapping="Wrap" />
                        <TextBox x:Name="TxtExtensions" Height="72" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Padding="8,6" />
                        <Button x:Name="BtnRestoreExt" Content="恢复默认后缀" Style="{StaticResource RoundedButton}"
                                Padding="14,6" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="RestoreExt_Click" />
                    </StackPanel>

                    <!-- 关于 -->
                    <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                        <TextBlock x:Name="AboutName" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="AboutVersion" Opacity="0.7" Margin="0,4,0,0" />
                        <TextBlock x:Name="AboutPositioning" Opacity="0.7" Margin="0,2,0,0" />
                        <TextBlock x:Name="AboutTech" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="配置目录" Opacity="0.65" Margin="0,16,0,4" />
                        <TextBlock x:Name="AboutConfigPath" Opacity="0.8" TextWrapping="Wrap" />
                        <Button x:Name="BtnOpenConfig" Content="打开配置目录" Style="{StaticResource RoundedButton}"
                                Padding="14,6" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="OpenConfig_Click" />
                        <TextBlock x:Name="AboutCopyright" Opacity="0.6" Margin="0,18,0,0" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,16,20,18">
            <Button x:Name="BtnRestore" Content="恢复默认" Style="{StaticResource RoundedButton}"
                    Padding="16,6" Margin="0,0,8,0" Click="Restore_Click" />
            <Button x:Name="BtnSave" Content="保存" Style="{StaticResource RoundedButton}"
                    Padding="16,6" Click="Save_Click" />
        </StackPanel>
    </Grid>
</UserControl>
